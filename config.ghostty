# ── Look ─────────────────────────────────────────
# Auto-follows macOS light/dark appearance
theme = dark:Catppuccin Mocha,light:Catppuccin Latte
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 15
# Crisper text on Retina
font-thicken = true
adjust-cell-height = 10%

background-opacity = 0.93
background-blur-radius = 20
window-padding-x = 12
window-padding-y = 8
window-padding-balance = true
window-theme = auto
# Tabs merged into the titlebar
macos-titlebar-style = tabs
cursor-style = bar
cursor-style-blink = false
# Dim inactive splits so focus is obvious
unfocused-split-opacity = 0.8
split-divider-color = #45475a
resize-overlay = never

# ── Behavior ─────────────────────────────────────
shell-integration = detect
# ssh-terminfo installs Ghostty's terminfo on remote hosts;
# ssh-env falls back to TERM=xterm-256color if that fails
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo
# Alt/Meta works in vim and readline
macos-option-as-alt = true
copy-on-select = clipboard
clipboard-paste-protection = true
# Remote OSC52 yanks land in your Mac clipboard
clipboard-write = allow
clipboard-read = ask
mouse-hide-while-typing = true
# In bytes; plenty for kubectl logs / dmesg
scrollback-limit = 100000000
confirm-close-surface = false
window-save-state = always
quit-after-last-window-closed = true

# ── Quick terminal (dropdown) ────────────────────
keybind = global:ctrl+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-screen = mouse
quick-terminal-autohide = true
quick-terminal-animation-duration = 0.15

# ── Splits ───────────────────────────────────────
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+alt+left=goto_split:left
keybind = super+alt+right=goto_split:right
keybind = super+alt+up=goto_split:up
keybind = super+alt+down=goto_split:down
keybind = super+shift+enter=toggle_split_zoom
keybind = super+ctrl+shift+equal=equalize_splits

# ── Navigation & scrollback ──────────────────────
# Jump between prompts (needs shell integration)
keybind = super+up=jump_to_prompt:-1
keybind = super+down=jump_to_prompt:1
# tmux copy-mode replacement: dump scrollback to a file and open it
keybind = super+shift+s=write_scrollback_file:open
# Shift+Enter inserts a newline in multi-line CLI prompts
keybind = shift+enter=text:\x1b\r
